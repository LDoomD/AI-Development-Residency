docs/sources/census-naics/ec2022-*/*.dat
docs/sources/census-naics/ec2022-*/*.zip

# Private API keys (never commit)
.env
.env.*

# Raw Apple review feed JSON keeps reviewer usernames. Kept on disk only; regenerate with
