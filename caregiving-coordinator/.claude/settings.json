{
  "//": "SessionStart and SubagentStart force the project skills directive into context instead of relying on Claude matching skill descriptions (.claude/hooks/emit-skills-directive.mjs). PreToolUse blocks git commit and gh pr create when the architecture gate fails (.claude/hooks/arch-gate-before-commit.mjs).",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/emit-skills-directive.mjs"],
            "timeout": 10,
            "statusMessage": "Loading project skills directive"
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/emit-skills-directive.mjs", "SubagentStart"],
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/arch-gate-before-commit.mjs"],
            "timeout": 60,
            "statusMessage": "Running architecture gate"
          }
        ]
      }
    ]
  }
}
