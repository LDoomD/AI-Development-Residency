{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id110630518"}, "name":{"label":"megaweenie"}, "label":""}, "updated":{"label":"2026-09-15T07:23:51-07:00"}, "im:rating":{"label":"4"}, "im:version":{"label":"2026.08.28"}, "id":{"label":"14552854657"}, "title":{"label":"Super helpful for families to stay organized, minor glitches"}, "content":{"label":"I always tell everyone about Cozi. We use it primarily for meal planning and grocery list creation. The only issue is that sometimes, even when online and with the app refreshed, some items don’t sync between users and it seems that they sometimes disappear, so you get home missing an ingredient.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=407108860&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
