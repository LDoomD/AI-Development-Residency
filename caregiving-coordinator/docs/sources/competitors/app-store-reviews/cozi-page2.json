{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id87332408"}, "name":{"label":"Floruh8"}, "label":""}, "updated":{"label":"2026-09-19T07:34:30-07:00"}, "im:rating":{"label":"3"}, "im:version":{"label":"2026.08.28"}, "id":{"label":"14568540960"}, "title":{"label":"Not user friendly"}, "content":{"label":"It is convenient for families but not user friendly. If I want to add in my work schedule (shift worker) if I copy over the event to a different date it adds the word ‘copy’ to it and I have to go back and erase the words. Your app should have a section for frequently used words/events so that I can easily add it to the calendar", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=407108860&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
