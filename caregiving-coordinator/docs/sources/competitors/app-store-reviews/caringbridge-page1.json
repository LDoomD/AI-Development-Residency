{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id1578164157"}, "name":{"label":"BigCookie48"}, "label":""}, "updated":{"label":"2025-12-26T17:33:40-07:00"}, "im:rating":{"label":"5"}, "im:version":{"label":"9.4.0"}, "id":{"label":"13559092065"}, "title":{"label":"Suggestions"}, "content":{"label":"I really like the app/product.  I saves me a lot of time. \nI would like to see several additions:\n1. When you list the visitors, please show the time of the last visit. \n2. Add the ability to download the visitor list with in CSV format. \n3. Add the ability to download the entire message stream as a PDF file for posterity. \nI did kick in $50.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=365726944&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
