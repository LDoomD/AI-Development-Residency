{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id821763091"}, "name":{"label":"kati429"}, "label":""}, "updated":{"label":"2025-10-22T18:39:07-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"9.1.1"}, "id":{"label":"13301780101"}, "title":{"label":"Rarely ever able to login"}, "content":{"label":"I get an error says oops something went wrong, but it’s not my login or password. Message says to report the issue but there’s no place to report the issue. No explanation or error code either.  I’ve deleted and redownloaded the app to my iPhone 16 pro and still no luck. I’ve successfully accessed the app maybe 1-2 times ever.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=365726944&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
