{"author":{"uri":{"label":"https://itunes.apple.com/us/reviews/id434031058"}, "name":{"label":"JTMH88"}, "label":""}, "updated":{"label":"2025-08-28T21:46:30-07:00"}, "im:rating":{"label":"1"}, "im:version":{"label":"3.234.1"}, "id":{"label":"13073085738"}, "title":{"label":"Notifications not always working"}, "content":{"label":"The whole reason I got this app was to remind me to take medication at a certain time. These alerts/notifications are not reliable. If I am actively using my phone, I do not receive any notification at all. No banner or when swiping from the top to see the Notification Center. I only receive notifications when my phone is locked. I have all notifications on for this app for the Lock Screen, Notification Center, and  banners. I’ve even tried setting the banner style to persistent.", "attributes":{"type":"text"}}, "link":{"attributes":{"rel":"related", "href":"https://itunes.apple.com/us/review?id=662170995&type=Purple%20Software"}}, "im:voteSum":{"label":"0"}, "im:contentType":{"attributes":{"term":"Application", "label":"Application"}}, "im:voteCount":{"label":"0"}}, 
