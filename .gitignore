# Repo-wide ignores for the residency repo.

# Editor and OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Secrets — never commit these
.env
.env*.local
.env.production
*.pem
*.key

# Dependencies
node_modules/

# Build output
.next/
out/
build/
dist/

# Agent tooling runtime state — not source
.memsearch/
.claude-flow/
.swarm/
.hive-mind/
ruvector.db
agentdb.rvf
agentdb.rvf.idmap.json

# Testing
coverage/

# Python
.venv/
__pycache__/
*.py[cod]

# Skill test outputs (trigger and quality test runs). Keep results in docs/, not in the repo tree.
**/.claude/skills/*-workspace/

# Claude Code private files. The docs say to keep these out of version control.
**/.claude/settings.local.json
**/CLAUDE.local.md
